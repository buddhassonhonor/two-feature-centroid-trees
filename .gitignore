# Default allowlist: exclude manuscript drafts, build artifacts, raw pickles, and large run directories
*

!.gitignore
!LICENSE
!README.md
!requirements-research.txt

!src/
!src/analyze.py
!src/audit_artifacts.py
!src/build_tables.py
!src/document_lht.py
!src/lht_adapter.cpp
!src/models.py
!src/plot_results.py
!src/prepare_data.py
!src/run_experiments.py
!src/run_lht.py
!src/run_matched.py
!src/run_supplement.py

!figures/
!figures/*.pdf
!figures/*.png

!exp/
!exp/*.csv
!exp/analysis_design.json
!exp/case_studies.json
!exp/friedman.json
!exp/reproduction_comparison.json
!exp/verification.json
!exp/data/
!exp/data/manifest.csv
!exp/data/*.json
!exp/tex/
!exp/tex/*.tex
!exp/metadata/
!exp/metadata/environment_freeze.txt
